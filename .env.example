# portfwd needs no secrets. It reads these optional tuning vars straight from the
# environment (there is no .env loader) — export them in your shell if needed.
# PORTFWD_STATE_DIR=       # where pid/log/state files live (default: $XDG_RUNTIME_DIR/portfwd-$USER)
# PORTFWD_RECONNECT_DELAY= # seconds to wait before reconnecting a dropped forward (default: 2)
# PORTFWD_AUDIT_LOG=       # where finished protected sessions are appended (default: $XDG_STATE_HOME/portfwd/protected.log)
