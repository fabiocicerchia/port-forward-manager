# pfm needs no secrets. It reads these optional tuning vars straight from the
# environment (there is no .env loader) — export them in your shell if needed.
# PFM_STATE_DIR=       # where pid/log/state files live (default: $XDG_RUNTIME_DIR/pfm-$USER)
# PFM_RECONNECT_DELAY= # seconds to wait before reconnecting a dropped forward (default: 2)
